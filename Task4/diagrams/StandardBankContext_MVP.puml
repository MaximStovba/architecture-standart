@startuml StandardBankContext
title Контекстная диаграмма: ИТ-системы банка «Стандарт» (MVP + ставки для кол-центров)

top to bottom direction

!include ./template/C4_Component.puml

' Акторы
Person(client_guest, "Клиент (неавторизованный)", "Подаёт заявку на сайте")
Person(client_authenticated, "Клиент (авторизованный)", "Оформляет депозит в интернет-банке")
Person(call_center_operator, "Оператор кол-центра", "Обрабатывает заявки клиентов, консультирует по ставкам")
Person(bo_manager, "Менеджер бэк-офиса", "Подтверждает условия в АБС, загружает ставки")
System_Ext(telecom_operator, "Телеком-оператор", "Доставляет СМС")
System_Ext(partner_callcenter, "Партнёрский кол-центр", "Обрабатывает обращения, получает файл со ставками")

' Основная система
System(std_it, "ИТ-системы банка «Стандарт»", "Обработка заявок, хранение ставок, интеграция с АБС")

' Взаимодействия
Rel(client_guest, std_it, "Заполняет заявку")
Rel(client_authenticated, std_it, "Оформляет заявку, подтверждает по СМС")
Rel(bo_manager, std_it, "Загружает ставки, подтверждает заявки")
Rel(std_it, telecom_operator, "Передаёт СМС клиенту")
Rel(std_it, partner_callcenter, "Экспортирует файл ставок (.csv)")
Rel(call_center_operator, std_it, "Работает с заявками и получает доступ к ставкам")

@enduml
